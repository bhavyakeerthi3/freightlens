{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": { "api/index.py": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/results", "destination": "/api/index?endpoint=results" },
    { "source": "/api/summary", "destination": "/api/index?endpoint=summary" },
    { "source": "/api/notes", "destination": "/api/index?endpoint=notes" },
    { "source": "/api/ask", "destination": "/api/index?endpoint=ask" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'" }
    ] },
    { "source": "/download/output.csv", "headers": [
      { "key": "Content-Disposition", "value": "attachment; filename=freight_analysis.csv" }
    ] }
  ]
}
